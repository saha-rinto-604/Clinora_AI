# Shared
COMPOSE_PROJECT_NAME=clinora-ai

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:8080/ws

# Spring Boot backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=clinora
POSTGRES_USER=clinora
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/clinora
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_USER=clinora
RABBITMQ_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
OCR_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8001

# Authentication / access security
AUTH_JWT_ISSUER=clinora-ai
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=30m
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
JWT_SECRET=replace-with-at-least-32-byte-random-secret
RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-byte-random-secret
BCRYPT_STRENGTH=12
AUTH_RATE_LIMIT_REGISTRATION_IP_LIMIT=5
AUTH_RATE_LIMIT_REGISTRATION_IP_WINDOW=1h
AUTH_RATE_LIMIT_REGISTRATION_EMAIL_LIMIT=3
AUTH_RATE_LIMIT_REGISTRATION_EMAIL_WINDOW=1h
AUTH_RATE_LIMIT_LOGIN_IP_LIMIT=5
AUTH_RATE_LIMIT_LOGIN_IP_WINDOW=1m
AUTH_RATE_LIMIT_LOGIN_EMAIL_LIMIT=10
AUTH_RATE_LIMIT_LOGIN_EMAIL_WINDOW=15m
AUTH_RATE_LIMIT_FORGOT_PASSWORD_IP_LIMIT=10
AUTH_RATE_LIMIT_FORGOT_PASSWORD_IP_WINDOW=1h
AUTH_RATE_LIMIT_FORGOT_PASSWORD_EMAIL_LIMIT=3
AUTH_RATE_LIMIT_FORGOT_PASSWORD_EMAIL_WINDOW=1h
AUTH_RATE_LIMIT_RESEND_VERIFICATION_IP_LIMIT=10
AUTH_RATE_LIMIT_RESEND_VERIFICATION_IP_WINDOW=1h
AUTH_RATE_LIMIT_RESEND_VERIFICATION_EMAIL_LIMIT=3
AUTH_RATE_LIMIT_RESEND_VERIFICATION_EMAIL_WINDOW=1h
AUTH_RATE_LIMIT_REFRESH_IP_LIMIT=120
AUTH_RATE_LIMIT_REFRESH_IP_WINDOW=1h

# Initial System Admin bootstrap (first successful bootstrap only)
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_FIRST_NAME=
SYSTEM_ADMIN_LAST_NAME=
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
MAIL_FROM=Clinora AI <noreply@example.invalid>

# Transactional email provider (Phase 4B)
# Local university testing: set EMAIL_PROVIDER=smtp and use a Google App Password.
EMAIL_PROVIDER=unconfigured
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional Resend provider
RESEND_API_KEY=
EMAIL_API_BASE_URL=https://api.resend.com

# Phase 4C professional applications
APPLICATION_EMAIL_VERIFICATION_TTL=24h
APPLICATION_PORTAL_LINK_TTL=30m
APPLICATION_SESSION_TTL=8h
APPLICATION_COOKIE_SECURE=false
APPLICATION_COOKIE_SAME_SITE=Lax
APPLICATION_MAX_DOCUMENT_SIZE=10MB
APPLICATION_INTERVIEW_DEFAULT_DURATION=30m
APPLICATION_INTERVIEW_REMINDER_OFFSETS=24h,1h
APPLICATION_INTERVIEW_REMINDER_SCAN_DELAY_MS=60000
APPLICATION_RATE_LIMIT_CREATE_IP_LIMIT=10
APPLICATION_RATE_LIMIT_CREATE_IP_WINDOW=1h
APPLICATION_RATE_LIMIT_CREATE_EMAIL_LIMIT=4
APPLICATION_RATE_LIMIT_CREATE_EMAIL_WINDOW=1h
APPLICATION_RATE_LIMIT_VERIFY_IP_LIMIT=30
APPLICATION_RATE_LIMIT_VERIFY_IP_WINDOW=1h
APPLICATION_RATE_LIMIT_ACCESS_LINK_IP_LIMIT=10
APPLICATION_RATE_LIMIT_ACCESS_LINK_IP_WINDOW=1h
APPLICATION_RATE_LIMIT_ACCESS_LINK_EMAIL_LIMIT=8
APPLICATION_RATE_LIMIT_ACCESS_LINK_EMAIL_WINDOW=1h
APPLICATION_RATE_LIMIT_SESSION_IP_LIMIT=30
APPLICATION_RATE_LIMIT_SESSION_IP_WINDOW=1h
APPLICATION_RATE_LIMIT_UPLOAD_APPLICATION_LIMIT=30
APPLICATION_RATE_LIMIT_UPLOAD_APPLICATION_WINDOW=1h
APPLICATION_RATE_LIMIT_SUBMIT_APPLICATION_LIMIT=10
APPLICATION_RATE_LIMIT_SUBMIT_APPLICATION_WINDOW=1h
S3_APPLICATION_ENDPOINT=http://localhost:9000
S3_APPLICATION_REGION=us-east-1
S3_APPLICATION_BUCKET=clinora-access-documents
S3_APPLICATION_ACCESS_KEY=clinora-minio
S3_APPLICATION_SECRET_KEY=replace-with-strong-local-secret
S3_APPLICATION_PATH_STYLE=true
S3_APPLICATION_AUTO_CREATE_BUCKET=true
MINIO_ROOT_USER=clinora-minio
MINIO_ROOT_PASSWORD=replace-with-strong-local-secret

# Private Patient medical report storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clinora-medical-reports
S3_ACCESS_KEY=clinora-minio
S3_SECRET_KEY=replace-with-strong-local-secret
S3_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
PATIENT_REPORT_MAX_FILE_SIZE=20MB
PATIENT_REPORT_MAX_REQUEST_SIZE=21MB

# Provider placeholders
HF_TOKEN=replace-me
HF_MODEL=replace-me-after-owner-confirms-availability
SMS_PROVIDER=placeholder
VIRUS_SCANNER_PROVIDER=placeholder

# OCR service
OCR_PORT=8000
OCR_MAX_WORKERS=2
OCR_JOB_TIMEOUT_SECONDS=60
OCR_MAX_FILE_SIZE_MB=50
OCR_MAX_PAGES=10

# AI service
AI_PORT=8001
AI_MAX_CONCURRENT_REQUESTS=2
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRY_ATTEMPTS=3
AI_RETRY_BASE_DELAY_SECONDS=1
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_SECONDS=60
